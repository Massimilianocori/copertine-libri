  "nmw_cambio": {
   "fonte": "uk27_nmw",
   "frase": "The rates change on 1 April every year."
  },
  "nmw_eta": {
   "fonte": "uk27_nmw",
   "frase": "aged 21 to get the National Living Wage - the minimum wage will still apply for workers aged 20 and under"
  },
  "nmw_apprendisti": {
   "fonte": "uk27_nmw",
   "frase": "Apprentices are entitled to the apprentice rate if they’re either: aged under 19 aged 19 or over and in the first year of their apprenticeship"
  },
  "nmw_apprendisti_dopo": {
   "fonte": "uk27_nmw",
   "frase": "Apprentices are entitled to the minimum wage for their age if they both: are aged 19 or over have completed the first year of their apprenticeship"
  },
  "lpc_annuncio": {
   "fonte": "uk27_lpc",
   "frase": "The Government has today announced increases to minimum wage rates from April 2027. The National Living Wage (NLW), the minimum wage rate for all workers aged 21 and over, will rise by 3.9 per cent to £13.21."
  },
  "lpc_altre": {
   "fonte": "uk27_lpc",
   "frase": "The minimum wage for 18-20 year olds will increase to £11.27 and the rates for 16-17 year olds and apprentices will increase to £8.31, all of which are 3.9 per cent increases in line with that for the NLW."
  },
  "lpc_accettato": {
   "fonte": "uk27_lpc",
   "frase": "In announcing these increases, the Government has accepted in full the recommendations made by the Low Pay Commission."
  },
  "dwp_stato": {
   "fonte": "uk27_dwp_indice",
   "frase": "This publication lists the benefit rates and pension rates for 2027 to 2028 as set out in the written ministerial statement made by the Secretary of State for Work and Pensions on 28 October 2026."
  },
  "dwp_titolo": {
   "fonte": "uk27_dwp",
   "frase": "Proposed benefit and pension rates 2027 to 2028"
  },
  "dwp_settimanali": {
   "fonte": "uk27_dwp",
   "frase": "Weekly rates, unless otherwise stated."
  },
  "nsp_chi": {
   "fonte": "uk27_guida_nsp",
   "frase": "You’ll be able to claim the new State Pension when you reach State Pension age if you’re: a man born on or after 6 April 1951 a woman born on or after 6 April 1953"
  },
  "nsp_importo": {
   "fonte": "uk27_guida_nsp_importo",
   "frase": "The full rate of new State Pension is £241.30 a week. Your amount could be different depending on: if you were contracted out before 2016 the number of National Insurance qualifying years you have if you paid into the Additional State Pension before 2016"
  },
  "nsp_35": {
   "fonte": "uk27_guida_nsp_importo",
   "frase": "If your National Insurance record started after April 2016 you will need 35 qualifying years to get the full rate of new State Pension."
  },
  "nsp_protetto": {
   "fonte": "uk27_guida_nsp_importo",
   "frase": "If you paid into the Additional State Pension before 2016 and would have got more State Pension under the old rules, you’ll get a ‘protected payment’. This is paid on top of the full rate of new State Pension."
  },
  "bsp_chi": {
   "fonte": "uk27_guida_bsp",
   "frase": "Everyone eligible for the basic State Pension has now reached State Pension age"
  },
  "bsp_nuova": {
   "fonte": "uk27_guida_bsp",
   "frase": "If you were born on or after these dates, you’ll claim the new State Pension instead."
  },
  "uc_dipende": {
   "fonte": "uk27_guida_uc",
   "frase": "Universal Credit is paid monthly . How much you get depends on: your standard allowance any extra amounts that apply to you any money taken off your payment if you’re working, how much you earn"
  },
  "uc_una": {
   "fonte": "uk27_guida_uc",
   "frase": "You’ll get one standard allowance for your household."
  },
  "uc_in_vigore": {
   "fonte": "uk27_guida_uc",
   "frase": "If you’re single and under 25 £338.58"
  },
  "ssp_regola": {
   "fonte": "uk27_guida_ssp",
   "frase": "If you’re eligible, you can get £123.25 a week Statutory Sick Pay ( SSP ) or 80% of your normal weekly earnings - whichever is lower. It’s paid for up to 28 weeks."
  },
  "ssp_datore": {
   "fonte": "uk27_guida_ssp",
   "frase": "SSP is paid by your employer in the same way as your normal wages, for example weekly or monthly."
  },
