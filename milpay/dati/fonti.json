  "hdoc189": {
   "titolo": "House Document 119-189, Alternative Plan for Pay Adjustments (letter of the President, August 26, 2026)",
   "chi": "119th Congress, 2d Session; referred August 27, 2026 (govinfo.gov, U.S. Government Publishing Office)",
