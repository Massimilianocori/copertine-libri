   "byte": 185037,
   "trovate": {
    "We establish the per diem rates that federal agencies use to reimburse their employees for lodging and meals and incidental expenses incurred while on official travel within the continental United States.": true,
    "A standard rate applies to most of CONUS.": true,
    "Individual rates apply to about 300 non-standard areas.": true,
    "Most NSAs are a key city/primary destination and the surrounding county.": true
   }
